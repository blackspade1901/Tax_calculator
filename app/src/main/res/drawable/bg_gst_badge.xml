<?xml version="1.0" encoding="utf-8"?>
<!--
    Badge background for the GST rate pill in item_history.xml.
    Uses a semi-transparent tint of colorPrimary so it adapts to both
    light and dark themes without needing a separate night/ variant.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <solid android:color="#1A6200EE" />   <!-- ~10% opacity colorPrimary -->

    <corners android:radius="20dp" />     <!-- Full pill rounding -->

    <stroke
        android:width="1dp"
        android:color="#336200EE" />      <!-- ~20% opacity border -->

</shape>